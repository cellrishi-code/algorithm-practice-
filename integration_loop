#include<bits/stdc++.h>
using namespace std;

double f(double x){
return x*x-2*x+1;
}

double trap(double a , double b){
    int n = 100;
    double s= f(a)+f(b);
    double h =(b-a)/n;
    for(int i = 1 ; i<n;i++){
        double x =a+i*h;
        s+=2*f(x);
    }
    return s*h/2;
}
double s13(double a , double b){
    int n =12;
    double s = f(a)+f(b);
    double h =(b-a)/n;
    for(int i =1 ; i<n ;i++){
        double x = a+i*h;
        if(i%2==0){
            s+=2*f(x);

        }
        else{
            s+=4*f(x);
        }
        }
        return h/3*s;
}

double s38(double a , double b ){
    int n = 12;
    double h =(b-a)/n;
    double s = f(a)+f(b);
    
    for(int i = 1 ; i<n ; i++){
        double x =a+i*h;
        if(i%3==0){
            s+=2*f(x);
        }
        else{
            s+=3*f(x);
        }
        
    }
    return (3*h*s)/8;
}

int main(){
    double a , b ;
    cin>>a>>b;
    cout<<trap(a,b)<<endl;
    cout<<s13(a,b)<<endl;
    cout<<s38(a,b);
    return 0 ;

}
