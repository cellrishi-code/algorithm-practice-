
#include <bits/stdc++.h>
using namespace std;

double lagrange(double x[], double y[], int n, double xp) {
    double ans = 0;

    for (int i = 0; i < n; i++) {
        double p = y[i];

        for (int j = 0; j < n; j++) {
            if (i != j) {
                p *= (xp - x[j]) / (x[i] - x[j]);
            }
        }

        ans += p;
    }

    return ans;
}

int main() {
    int n;
    cout << "Enter number of data points: ";
    cin >> n;

    double x[n], y[n];

    cout << "Enter x values:\n";
    for (int i = 0; i < n; i++) {
        cin >> x[i];
    }

    cout << "Enter y values:\n";
    for (int i = 0; i < n; i++) {
        cin >> y[i];
    }

    double xp;
    cout << "Enter interpolation point: ";
    cin >> xp;

    cout << "Interpolated value = "
         << lagrange(x, y, n, xp);

    return 0;
}
